# Docker image used by scripts/run_bench.sh
MEOWGO_DOCKER_IMAGE=meowgo

# Meow benchmark parameters
MEOW_LOG_K=10
MEOW_RHO=1/2
MEOW_L=128
# Supported linkers: sigma, qa_nizk, qa_batch
MEOW_LINKER=qa_batch
MEOW_MERKLE=multi
MEOW_ALL=false
MEOW_ONLY_COMPILE=false
MEOW_OUTPUT_DIR=benchmark/meow

# Used when MEOW_ALL=true, --all is passed, or scripts/run_bench.sh meow --range is used
MEOW_LOG_K_FROM=7
MEOW_LOG_K_TO=13

# Freivalds benchmark parameters
FREIVALDS_LOG_K=10
FREIVALDS_ALL=false
FREIVALDS_ONLY_COMPILE=false
FREIVALDS_OUTPUT_DIR=benchmark/freivalds

# Used when FREIVALDS_ALL=true, --all is passed, or scripts/run_bench.sh freivalds --range is used
FREIVALDS_LOG_K_FROM=7
FREIVALDS_LOG_K_TO=13

# Rectangular Meow benchmark parameters
RECTMEOW_ROWS=2
RECTMEOW_INNER=2
RECTMEOW_COLS=2
RECTMEOW_RHO=1/2
RECTMEOW_L=2
RECTMEOW_ONLY_COMPILE=false
RECTMEOW_OUTPUT_DIR=benchmark/rectmeow

# Packed-QKV Meow GPT-2 medium one-layer matmul-only benchmark parameters
MEOW_GPT2_SEQ=10
MEOW_GPT2_RHO=1/2
MEOW_GPT2_L=128
# Supported linkers: sigma, qa_nizk, qa_batch
MEOW_GPT2_LINKER=qa_batch
MEOW_GPT2_MERKLE=multi
MEOW_GPT2_ALL=false
MEOW_GPT2_SEQ_FROM=7
MEOW_GPT2_SEQ_TO=10
MEOW_GPT2_ONLY_COMPILE=false
MEOW_GPT2_OUTPUT_DIR=benchmark/meow_gpt2

# Packed-QKV Freivalds GPT-2 medium one-layer matmul-only benchmark parameters
FREIVALDS_GPT2_SEQ=10
FREIVALDS_GPT2_ALL=false
FREIVALDS_GPT2_SEQ_FROM=7
FREIVALDS_GPT2_SEQ_TO=10
FREIVALDS_GPT2_ONLY_COMPILE=false
FREIVALDS_GPT2_OUTPUT_DIR=benchmark/freivalds_gpt2
