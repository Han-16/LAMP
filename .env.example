# Docker image used by scripts/run_bench.sh
MEOWGO_DOCKER_IMAGE=meowgo

# Meow benchmark parameters
MEOW_LOG_K=10
MEOW_RHO=1/2
MEOW_L=128
MEOW_ALL=false
MEOW_ONLY_COMPILE=false
MEOW_OUTPUT_DIR=benchmark/meow

# Used when MEOW_ALL=true, --all is passed, or scripts/run_bench.sh meow --range is used
MEOW_LOG_K_FROM=7
MEOW_LOG_K_TO=15

# Freivalds benchmark parameters
FREIVALDS_LOG_K=11
FREIVALDS_ALL=false
FREIVALDS_ONLY_COMPILE=false
FREIVALDS_OUTPUT_DIR=benchmark/freivalds

# Used when FREIVALDS_ALL=true, --all is passed, or scripts/run_bench.sh freivalds --range is used
FREIVALDS_LOG_K_FROM=7
FREIVALDS_LOG_K_TO=15

# GPT-2 matmul-only benchmark parameters
GPT2_PROTOCOL=meow
GPT2_MODEL=medium
GPT2_SEQ_LEN=1024
GPT2_L=128
GPT2_RHO=1/2
GPT2_ONLY_COMPILE=false
GPT2_OUTPUT_DIR=benchmark/gpt2
