# Docker image used by scripts/run_bench.sh
LAMP_DOCKER_IMAGE=lamp

# LAMP benchmark parameters
LAMP_LOG_K=10
RHO=1/2
LAMP_L=
LAMP_ALL=false
LAMP_ONLY_COMPILE=false
LAMP_OUTPUT_DIR=benchmark/lamp

# Used when LAMP_ALL=true, --all is passed, or scripts/run_bench.sh lamp --range is used
LAMP_LOG_K_FROM=8
LAMP_LOG_K_TO=13

# LAMP random-linear-combination batch benchmark parameters
LAMP_BATCH_LOG_K=7
LAMP_BATCH_L=
LAMP_BATCH_SIZE=5
LAMP_BATCH_ALL=false
LAMP_BATCH_RANGE=false
LAMP_BATCH_ONLY_COMPILE=false
LAMP_BATCH_OUTPUT_DIR=benchmark/lamp_batch

# Used when LAMP_BATCH_ALL=true, --all is passed, or scripts/run_bench.sh lamp_batch --range is used
LAMP_BATCH_LOG_K_FROM=8
LAMP_BATCH_LOG_K_TO=13

# Used when LAMP_BATCH_RANGE=true or --batch-range is passed
LAMP_BATCH_FROM=1
LAMP_BATCH_TO=10

# Freivalds benchmark parameters
FREIVALDS_LOG_K=10
FREIVALDS_ALL=false
FREIVALDS_ONLY_COMPILE=false
FREIVALDS_OUTPUT_DIR=benchmark/freivalds

# Used when FREIVALDS_ALL=true, --all is passed, or scripts/run_bench.sh freivalds --range is used
FREIVALDS_LOG_K_FROM=7
FREIVALDS_LOG_K_TO=13

# Freivalds batch benchmark parameters
FREIVALDS_BATCH_LOG_K=7
FREIVALDS_BATCH_SIZE=5
FREIVALDS_BATCH_ALL=false
FREIVALDS_BATCH_RANGE=false
FREIVALDS_BATCH_ONLY_COMPILE=false
FREIVALDS_BATCH_OUTPUT_DIR=benchmark/freivalds_batch

# Used when FREIVALDS_BATCH_ALL=true, --all is passed, or scripts/run_bench.sh freivalds_batch --range is used
FREIVALDS_BATCH_LOG_K_FROM=7
FREIVALDS_BATCH_LOG_K_TO=13

# Used when FREIVALDS_BATCH_RANGE=true or --batch-range is passed
FREIVALDS_BATCH_FROM=1
FREIVALDS_BATCH_TO=10

# Packed-QKV LAMP GPT-2 medium one-layer matmul-only benchmark parameters
LAMP_GPT2_SEQ=10
LAMP_GPT2_L=
LAMP_GPT2_ALL=false
LAMP_GPT2_SEQ_FROM=7
LAMP_GPT2_SEQ_TO=10
LAMP_GPT2_ONLY_COMPILE=false
LAMP_GPT2_OUTPUT_DIR=benchmark/lamp_gpt2

# Packed-QKV Freivalds GPT-2 medium one-layer matmul-only benchmark parameters
FREIVALDS_GPT2_SEQ=10
FREIVALDS_GPT2_ALL=false
FREIVALDS_GPT2_SEQ_FROM=7
FREIVALDS_GPT2_SEQ_TO=10
FREIVALDS_GPT2_ONLY_COMPILE=false
FREIVALDS_GPT2_OUTPUT_DIR=benchmark/freivalds_gpt2
